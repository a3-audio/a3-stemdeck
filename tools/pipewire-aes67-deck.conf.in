# SPDX-License-Identifier: GPL-3.0-or-later
#
# AES67 sender of one deck: MAIN (16 channels), AUX (16) and CUE (9) as three sessions of
# their own, as the Core sends its streams -- or, where the deck's "Output: Stereo" is set,
# one STEREO session (MASTER_L, MASTER_R). The sinks come from pipewire-aes67-deck-sink.conf.in
# (at the end of the modules). A template: stemdeck-aes67-deck renders it
# into ~/.config/pipewire/pipewire-aes67-deck-<X>.conf from the truth, and
# a3-aes67-deck@<X>.service runs it as a PipeWire instance of its own.
#
# No PTP driver here: the rtp-sink joins pipewire.ptp0, which the host's base
# instance (stemdeck-aes67.service) drives; two PTP0 drivers in one graph
# would fight (plan ruling R4).

context.properties = {
    # Errors only: the sender warns "missing timeout" hundreds of times a second.
    log.level = 1
}

context.spa-libs = {
    support.*       = support/libspa-support
}

context.modules = [
    { name = libpipewire-module-rt
        args = {
            nice.level = -11
        }
        flags = [ ifexists nofail ]
    }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    # Only to announce the sender: with no rule to make a stream, it receives nothing.
    { name = libpipewire-module-rtp-sap
        args = {
            local.ifname = "@AUDIO_PORT@"
            sap.ip = "@SAP_IP@"
            sap.port = @SAP_PORT@
            net.ttl = 32
            net.loop = @NET_LOOP@
            ptp.management-socket = "/var/run/ptp4lro"
            stream.rules = [
                {
                    matches = [
                        {
                            sess.sap.announce = true
                        }
                    ]
                    actions = {
                        announce-stream = {}
                    }
                }
            ]
        }
    }
@SINKS@
]
