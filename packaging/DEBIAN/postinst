#!/bin/sh
# Enables StemDeck's user unit for every user and restarts the decks that run:
# no write into any home, nothing started that was stopped. Updates are not made
# during a set (the maintainer, 2026-11-18), so the new binary, units and link
# maps take over at once instead of waiting for someone to remember.
set -e

if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
	systemctl --global enable stemdeck.service || true
	# Every running user manager learns of the new unit file. Only a reload:
	# reaching a user manager needs its user's name, which loginctl gives here,
	# so no user is hard-coded.
	for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
		systemctl --user --machine="$user@" daemon-reload 2>/dev/null || true
		systemctl --user --machine="$user@" try-restart stemdeck.service 'stemdeck@*.service' 2>/dev/null || true
	done
	# Energy Efficient Ethernet off now; the udev rule covers later boots.
	for port in /sys/class/net/eth* /sys/class/net/en*; do
		[ -e "$port" ] && /usr/sbin/ethtool --set-eee "${port##*/}" eee off >/dev/null 2>&1 || true
	done
	echo "stemdeck: installed. A running StemDeck was restarted on the new version."
fi

exit 0
